<aside id="sidebar"
    class="fixed md:sticky top-14 left-0 z-40 w-64 h-[calc(100vh-3.5rem)] bg-gray-950 border-r border-gray-900 transition-all duration-300 ease-in-out -translate-x-full md:translate-x-0 overflow-hidden">
    <div class="p-4 flex flex-col h-full gap-1.5 w-64">
        <p class="text-[10px] font-black uppercase text-gray-500 tracking-wider mb-2 px-3">Navegación</p>

        <a href="/"
            class="flex items-center gap-3 px-3 py-2 text-sm text-gray-300 hover:bg-emerald-500/10 hover:text-emerald-400 rounded-md transition-all group">
            <i
                class="fa-solid fa-house w-4.5 text-center text-gray-500 group-hover:text-emerald-400 transition-colors text-xs"></i>
            <span class="font-medium">Inicio</span>
        </a>

        <a href="/vacantes"
            class="flex items-center gap-3 px-3 py-2 text-sm text-gray-300 hover:bg-emerald-500/10 hover:text-emerald-400 rounded-md transition-all group">
            <i
                class="fa-solid fa-briefcase w-4.5 text-center text-gray-500 group-hover:text-emerald-400 transition-colors text-xs"></i>
            <span class="font-medium">Vacantes</span>
        </a>

        <a href="/vacantes/mis-vacantes"
            class="flex items-center gap-3 px-3 py-2 text-sm text-gray-300 hover:bg-emerald-500/10 hover:text-emerald-400 rounded-md transition-all group">
            <i
                class="fa-solid fa-list-check w-4.5 text-center text-gray-500 group-hover:text-emerald-400 transition-colors text-xs"></i>
            <span class="font-medium">Mis Vacantes</span>
        </a>

        <a href="/postulaciones/mis-postulaciones"
            class="flex items-center gap-3 px-3 py-2 text-sm text-gray-300 hover:bg-emerald-500/10 hover:text-emerald-400 rounded-md transition-all group">
            <i
                class="fa-solid fa-file-lines w-4.5 text-center text-gray-500 group-hover:text-emerald-400 transition-colors text-xs"></i>
            <span class="font-medium">Mis Postulaciones</span>
        </a>

        {{#if (eq usuario.rol 'admin')}}
            <a href="/admin"
                class="flex items-center gap-3 px-3 py-2 text-sm text-gray-300 hover:bg-emerald-500/10 hover:text-emerald-400 rounded-md transition-all group">
                <i
                    class="fa-solid fa-shield-halved w-4.5 text-center text-gray-500 group-hover:text-emerald-400 transition-colors text-xs"></i>
                <span class="font-medium">SuperAdmin</span>
            </a>
        {{/if}}

        <div class="mt-auto pt-6 border-t border-gray-900">
            <a href="/perfil"
                class="flex items-center gap-3 px-3 py-2 text-sm text-gray-300 hover:bg-emerald-500/10 hover:text-emerald-400 rounded-md transition-all group">
                <i
                    class="fa-solid fa-user w-4.5 text-center text-gray-500 group-hover:text-emerald-400 transition-colors text-xs"></i>
                <span class="font-medium">Mi Perfil</span>
            </a>
        </div>
    </div>
</aside>
