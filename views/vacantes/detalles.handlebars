<div class="max-w-7xl mx-auto mt-10 px-4">
    
    <div class="mb-6">
        <a href="/vacantes/mis-vacantes" class="inline-flex items-center gap-2 text-gray-400 hover:text-emerald-400 transition-colors text-sm font-medium group">
            <i class="fa-solid fa-arrow-left transition-transform group-hover:-translate-x-1"></i>
            Volver a las vacantes
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        {{!-- PANEL IZQUIERDO: Resumen de la vacante --}}
        <div class="lg:col-span-1 bg-white/5 border border-gray-800 rounded-2xl p-6 h-fit">
            <h3 class="text-xl font-bold text-emerald-400 mb-4">Estado Actual</h3>
            
            <div class="mb-6">
                {{#if (eq vacante.estado 'abierta')}}
                    <span class="bg-emerald-500/20 text-emerald-400 px-4 py-2 rounded-full font-bold uppercase text-sm tracking-widest flex items-center w-fit gap-2">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> Abierta
                    </span>
                    <p class="text-gray-400 text-sm mt-3">Recibiendo postulaciones</p>
                    
                    {{!-- BOTÓN PARA CERRAR --}}
                    <form id="form-cerrar-{{vacante.id}}" action="/vacantes/mis-vacantes/cerrar/{{vacante.id}}" method="POST" class="mt-6" >
                        <button type="button" onclick="confirmarCierre('{{vacante.id}}')" class="w-full bg-orange-500/10 border border-orange-500 text-orange-400 hover:bg-orange-500 hover:text-white font-bold py-3 rounded-xl transition-colors">
                            Cerrar Vacante
                        </button>
                    </form>
                {{else}}
                    <span class="bg-red-500/20 text-red-400 px-4 py-2 rounded-full font-bold uppercase text-sm tracking-widest">
                        Cerrada
                    </span>
                    <p class="text-gray-400 text-sm mt-3">Esta vacante ya no acepta candidatos</p>
                {{/if}}
            </div>

            <hr class="border-gray-800 my-6">
            
            <div class="text-gray-400 text-sm space-y-3">
                <p><strong>Ubicación:</strong> {{vacante.ubicacion}}</p>
                <p><strong>Contrato:</strong> {{vacante.tipo_contrato}}</p>
                <p><strong>Salario:</strong> ${{vacante.salario}}</p>
            </div>
        </div>

        {{!-- PANEL DERECHO: Tabla de Candidatos --}}
        <div class="lg:col-span-2">
            <div class="bg-white/5 border border-gray-800 rounded-2xl overflow-hidden">
                <div class="p-6 border-b border-gray-800 bg-[#100E17]">
                    <h2 class="text-2xl font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-users text-emerald-400"></i> Candidatos Postulados ({{candidatos.length}})
                    </h2>
                </div>

                {{#if candidatos.length}}
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-gray-400">
                            <thead class="text-xs text-gray-500 uppercase bg-black/20 border-b border-gray-800">
                                <tr>
                                    <th scope="col" class="px-6 py-4">Candidato</th>
                                    <th scope="col" class="px-6 py-4">Match Score</th>
                                    <th scope="col" class="px-6 py-4">Email</th>
                                    <th scope="col" class="px-6 py-4">Hoja de Vida</th>
                                    <th scope="col" class="px-6 py-4">Estado</th>
                                    <th scope="col" class="px-6 py-4">Acción</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-800">
                                {{#each candidatos}}
                                    <tr class="hover:bg-white/5 transition-colors">
                                        <td class="px-6 py-4 font-medium text-white flex items-center gap-3">
                                            {{#if usuario.foto_perfil}}
                                                <img src="/uploads/perfiles/{{usuario.foto_perfil}}" class="w-10 h-10 rounded-full object-cover border border-gray-700">
                                            {{else}}
                                                <div class="w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center text-gray-500 font-bold">
                                                    <i class="fa-solid fa-user"></i>
                                                </div>
                                            {{/if}}
                                            {{usuario.nombre}}
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="flex items-center gap-2">
                                                <div class="w-full bg-gray-800 rounded-full h-2 max-w-25">
                                                    <div class="h-2 rounded-full {{#if (eq matchScore 100)}}bg-emerald-500{{else}}{{#if (gt matchScore 70)}}bg-blue-500{{else}}bg-orange-500{{/if}}{{/if}}" style="width: {{matchScore}}%"></div>
                                                </div>
                                                <span class="text-xs font-black {{#if (eq matchScore 100)}}text-emerald-400{{else}}{{#if (gt matchScore 70)}}text-blue-400{{else}}text-orange-400{{/if}}{{/if}}">{{matchScore}}%</span>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4">{{usuario.email}}</td>
                                        
                                        <td class="px-6 py-4">
                                            {{#if usuario.cvs.length}}
                                                <a href="/uploads/cvs/{{usuario.cvs.[0].url_archivo}}" target="_blank" class="text-emerald-400 hover:text-emerald-300 hover:underline flex items-center gap-1">
                                                    <i class="fa-solid fa-file-pdf"></i> Ver Documento
                                                </a>
                                            {{else}}
                                                <span class="text-gray-600 text-xs">Sin CV</span>
                                            {{/if}}
                                        </td>

                                        {{!-- Columna de Estado --}}
                                        <td class="px-6 py-4">
                                            {{#if (eq estado 'pendiente')}}
                                                <span class="bg-yellow-500/15 text-yellow-400 px-3 py-1 rounded-full text-xs font-bold uppercase flex items-center gap-1.5 w-fit">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-yellow-400 animate-pulse"></span> Pendiente
                                                </span>
                                            {{/if}}
                                            {{#if (eq estado 'aceptado')}}
                                                <span class="bg-emerald-500/15 text-emerald-400 px-3 py-1 rounded-full text-xs font-bold uppercase flex items-center gap-1.5 w-fit">
                                                    <i class="fa-solid fa-check text-[10px]"></i> Aceptado
                                                </span>
                                            {{/if}}
                                            {{#if (eq estado 'rechazado')}}
                                                <span class="bg-red-500/15 text-red-400 px-3 py-1 rounded-full text-xs font-bold uppercase flex items-center gap-1.5 w-fit">
                                                    <i class="fa-solid fa-xmark text-[10px]"></i> Rechazado
                                                </span>
                                            {{/if}}
                                        </td>

                                        {{!-- Columna de Acciones --}}
                                        <td class="px-6 py-4">
                                            {{#if (eq estado 'pendiente')}}
                                                <div class="flex items-center gap-2">
                                                    {{!-- Formulario oculto para Aceptar --}}
                                                    <form id="form-aceptar-{{id}}" action="/vacantes/postulacion/estado/{{id}}" method="POST" class="hidden">
                                                        <input type="hidden" name="estado" value="aceptado">
                                                        <input type="hidden" name="vacante_id" value="{{../vacante.id}}">
                                                    </form>
                                                    <button type="button" onclick="confirmarAccion('{{id}}', 'aceptar')" 
                                                        class="bg-emerald-500/10 border border-emerald-500/50 text-emerald-400 hover:bg-emerald-500 hover:text-white text-xs font-bold py-2 px-3 rounded-lg transition-all" title="Aceptar candidato">
                                                        <i class="fa-solid fa-check mr-1"></i> Aceptar
                                                    </button>

                                                    {{!-- Formulario oculto para Rechazar --}}
                                                    <form id="form-rechazar-{{id}}" action="/vacantes/postulacion/estado/{{id}}" method="POST" class="hidden">
                                                        <input type="hidden" name="estado" value="rechazado">
                                                        <input type="hidden" name="vacante_id" value="{{../vacante.id}}">
                                                    </form>
                                                    <button type="button" onclick="confirmarAccion('{{id}}', 'rechazar')" 
                                                        class="bg-red-500/10 border border-red-500/50 text-red-400 hover:bg-red-500 hover:text-white text-xs font-bold py-2 px-3 rounded-lg transition-all" title="Rechazar candidato">
                                                        <i class="fa-solid fa-xmark mr-1"></i> Rechazar
                                                    </button>
                                                </div>
                                            {{else}}
                                                <div class="flex items-center gap-2">
                                                    {{#if whatsappUrl}}
                                                        <a href="{{whatsappUrl}}" target="_blank" rel="noopener noreferrer" class="bg-green-600 hover:bg-green-500 text-white text-xs font-bold py-2 px-3 rounded-lg transition-colors inline-flex items-center gap-2">
                                                            <i class="fa-brands fa-whatsapp"></i>
                                                            WhatsApp
                                                        </a>
                                                    {{else}}
                                                        <span class="bg-gray-800 text-gray-500 text-xs font-bold py-2 px-3 rounded-lg inline-flex items-center gap-2 cursor-not-allowed">
                                                            <i class="fa-solid fa-phone-slash"></i>
                                                            Sin WhatsApp
                                                        </span>
                                                    {{/if}}
                                                    <a href="mailto:{{usuario.email}}" class="bg-gray-800 hover:bg-emerald-500 hover:text-gray-950 text-white text-xs font-bold py-2 px-3 rounded-lg transition-colors inline-flex items-center gap-2">
                                                        <i class="fa-solid fa-envelope"></i>
                                                        Gmail
                                                    </a>
                                                </div>
                                            {{/if}}
                                        </td>
                                    </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                {{else}}
                    <div class="p-10 text-center">
                        <i class="fa-regular fa-face-frown-open text-5xl text-gray-600 mb-4 block"></i>
                        <p class="text-gray-400">Aún no hay candidatos postulados a esta vacante.</p>
                    </div>
                {{/if}}
            </div>
        </div>
        
    </div>
</div>

<script>
    // Función para cerrar vacante (ya existente)
    function confirmarCierre(id) {
        Swal.fire({
            title: '¿Cerrar vacante?',
            text: "Ya no recibirás más postulaciones para este cargo. Esta acción no se puede deshacer.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#f97316',
            cancelButtonColor: '#374151',
            confirmButtonText: 'Sí, cerrar vacante',
            cancelButtonText: 'Cancelar',
            background: '#111827',
            color: '#fff'
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById(`form-cerrar-${id}`).submit();
            }
        });
    }

    // Función para aceptar o rechazar un candidato
    function confirmarAccion(postulacionId, accion) {
        const config = {
            aceptar: {
                title: '¿Aceptar candidato?',
                text: 'El candidato será marcado como aceptado para esta vacante.',
                icon: 'question',
                confirmButtonColor: '#10b981',
                confirmButtonText: '<i class="fa-solid fa-check"></i> Sí, aceptar',
            },
            rechazar: {
                title: '¿Rechazar candidato?',
                text: 'El candidato será marcado como rechazado para esta vacante.',
                icon: 'warning',
                confirmButtonColor: '#ef4444',
                confirmButtonText: '<i class="fa-solid fa-xmark"></i> Sí, rechazar',
            }
        };

        const c = config[accion];

        Swal.fire({
            title: c.title,
            text: c.text,
            icon: c.icon,
            showCancelButton: true,
            confirmButtonColor: c.confirmButtonColor,
            cancelButtonColor: '#374151',
            confirmButtonText: c.confirmButtonText,
            cancelButtonText: 'Cancelar',
            background: '#111827',
            color: '#fff'
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById(`form-${accion}-${postulacionId}`).submit();
            }
        });
    }
</script>
