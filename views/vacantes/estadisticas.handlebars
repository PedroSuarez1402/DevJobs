<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="text-3xl font-black text-white mb-2">{{nombrePagina}}</h1>
            <p class="text-gray-400 font-medium">{{tagline}}</p>
        </div>
        <a href="/vacantes/mis-vacantes" class="bg-gray-800 hover:bg-gray-700 text-white px-6 py-3 rounded-xl text-sm font-black uppercase transition-all flex items-center gap-2 w-fit">
            <i class="fa-solid fa-arrow-left"></i>
            Volver al Panel
        </a>
    </div>

    <!-- Tarjetas de Resumen -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
        <div class="bg-gray-900 border border-gray-800 p-6 rounded-2xl shadow-sm">
            <div class="flex items-center gap-4 mb-2">
                <div class="w-10 h-10 bg-blue-500/10 rounded-lg flex items-center justify-center text-blue-500">
                    <i class="fa-solid fa-eye text-xl"></i>
                </div>
                <h3 class="text-gray-400 text-sm font-bold uppercase tracking-wider">Visualizaciones</h3>
            </div>
            <p class="text-4xl font-black text-white">{{estadisticas.totalVisualizaciones}}</p>
            <p class="text-xs text-gray-500 mt-2">Personas que han visto la vacante</p>
        </div>

        <div class="bg-gray-900 border border-gray-800 p-6 rounded-2xl shadow-sm">
            <div class="flex items-center gap-4 mb-2">
                <div class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center text-emerald-500">
                    <i class="fa-solid fa-users text-xl"></i>
                </div>
                <h3 class="text-gray-400 text-sm font-bold uppercase tracking-wider">Postulaciones</h3>
            </div>
            <p class="text-4xl font-black text-white">{{estadisticas.totalPostulaciones}}</p>
            <p class="text-xs text-gray-500 mt-2">Candidatos interesados</p>
        </div>

        <div class="bg-gray-900 border border-gray-800 p-6 rounded-2xl shadow-sm">
            <div class="flex items-center gap-4 mb-2">
                <div class="w-10 h-10 bg-purple-500/10 rounded-lg flex items-center justify-center text-purple-500">
                    <i class="fa-solid fa-chart-pie text-xl"></i>
                </div>
                <h3 class="text-gray-400 text-sm font-bold uppercase tracking-wider">Tasa de Conversión</h3>
            </div>
            <p class="text-4xl font-black text-white">{{estadisticas.tasaConversion}}%</p>
            <p class="text-xs text-gray-500 mt-2">Porcentaje de vistas que postulan</p>
        </div>
    </div>

    <!-- Gráfica de Conversión -->
    <div class="bg-gray-900 border border-gray-800 p-8 rounded-3xl shadow-sm mb-10">
        <h3 class="text-xl font-bold text-white mb-2 flex items-center gap-2">
            <i class="fa-solid fa-chart-pie text-purple-500"></i>
            Conversión (Visitas vs Postulaciones)
        </h3>
        <p class="text-sm text-gray-400 mb-6">
            De {{estadisticas.totalVisualizaciones}} visitas, tuviste {{estadisticas.totalPostulaciones}} postulaciones = <span class="font-black text-white">{{estadisticas.tasaConversion}}%</span> de conversión.
        </p>
        <div class="h-[360px] w-full">
            <canvas id="graficaConversion" data-visitas="{{estadisticas.totalVisualizaciones}}" data-postulaciones="{{estadisticas.totalPostulaciones}}"></canvas>
        </div>
    </div>

    <!-- Gráfica de Postulaciones -->
    <div class="bg-gray-900 border border-gray-800 p-8 rounded-3xl shadow-sm mb-10">
        <h3 class="text-xl font-bold text-white mb-6 flex items-center gap-2">
            <i class="fa-solid fa-chart-line text-emerald-500"></i>
            Crecimiento de Postulaciones (Últimos 7 días)
        </h3>
        <div class="h-[400px] w-full">
            <canvas id="graficaPostulaciones" data-labels='{{json estadisticas.labels}}' data-values='{{json estadisticas.data}}'></canvas>
        </div>
    </div>
</div>
