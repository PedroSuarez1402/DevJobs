<div class="max-w-7xl mx-auto mt-10 px-4">
    
    {{!-- Cabecera de la sección --}}
    <div class="flex flex-col md:flex-row justify-between items-center mb-8 border-b border-gray-800 pb-6">
        <div>
            <h1 class="text-4xl font-black text-white mb-2">Explorar Vacantes</h1>
            <p class="text-xl text-gray-400">Encuentra tu próximo desafío profesional</p>
        </div>
        <div class="mt-4 md:mt-0">
            <a href="/vacantes/nueva" class="bg-[#00C897] hover:bg-[#0a9b77] text-white font-bold py-3 px-6 rounded-lg text-lg transition-colors flex items-center gap-2">
                <i class="fa-solid fa-plus"></i> Publicar Vacante
            </a>
        </div>
    </div>

    {{!-- Barra de Búsqueda y Filtros --}}
    <form action="/vacantes" method="GET" class="bg-white/5 border border-gray-800 rounded-2xl p-5 mb-8">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
            
            {{!-- Palabra clave --}}
            <div class="md:col-span-4">
                <label for="keyword" class="block text-xs text-gray-500 font-bold uppercase mb-2">Palabra clave</label>
                <div class="relative">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-gray-600 text-sm"></i>
                    <input type="text" name="keyword" id="keyword" value="{{filtros.keyword}}" placeholder="React, Node.js, Diseñador..."
                        class="w-full bg-[#100E17] border border-gray-700 rounded-xl pl-10 pr-4 py-3 text-white text-sm focus:outline-none focus:border-[#00C897] placeholder-gray-600">
                </div>
            </div>

            {{!-- Ubicación --}}
            <div class="md:col-span-3">
                <label for="ubicacion" class="block text-xs text-gray-500 font-bold uppercase mb-2">Ubicación</label>
                <div class="relative">
                    <i class="fa-solid fa-location-dot absolute left-3 top-1/2 -translate-y-1/2 text-gray-600 text-sm"></i>
                    <input type="text" name="ubicacion" id="ubicacion" value="{{filtros.ubicacion}}" placeholder="Remoto, Bogotá..."
                        class="w-full bg-[#100E17] border border-gray-700 rounded-xl pl-10 pr-4 py-3 text-white text-sm focus:outline-none focus:border-[#00C897] placeholder-gray-600">
                </div>
            </div>

            {{!-- Tipo de contrato --}}
            <div class="md:col-span-3">
                <label for="tipo_contrato" class="block text-xs text-gray-500 font-bold uppercase mb-2">Contrato</label>
                <select name="tipo_contrato" id="tipo_contrato"
                    class="w-full bg-[#100E17] border border-gray-700 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-[#00C897] appearance-none cursor-pointer">
                    <option value="" {{#unless filtros.tipo_contrato}}selected{{/unless}}>Todos</option>
                    <option value="Indefinido" {{#if (eq filtros.tipo_contrato 'Indefinido')}}selected{{/if}}>Término Indefinido</option>
                    <option value="Fijo" {{#if (eq filtros.tipo_contrato 'Fijo')}}selected{{/if}}>Término Fijo</option>
                    <option value="Proyecto" {{#if (eq filtros.tipo_contrato 'Proyecto')}}selected{{/if}}>Por Proyecto / Freelance</option>
                </select>
            </div>

            {{!-- Botones --}}
            <div class="md:col-span-2 flex gap-2">
                <button type="submit" class="flex-1 bg-[#00C897] hover:bg-[#0a9b77] text-white font-bold py-3 rounded-xl text-sm transition-colors flex justify-center items-center gap-2">
                    <i class="fa-solid fa-magnifying-glass"></i> Buscar
                </button>
                <a href="/vacantes" class="bg-gray-800 hover:bg-gray-700 text-gray-400 hover:text-white font-bold py-3 px-3 rounded-xl text-sm transition-colors flex items-center" title="Limpiar filtros">
                    <i class="fa-solid fa-xmark"></i>
                </a>
            </div>
        </div>
    </form>

    {{!-- Contador de resultados --}}
    {{#if vacantes.length}}
        <p class="text-gray-500 text-sm mb-6 font-medium">
            <span class="text-white font-bold">{{paginacion.totalVacantes}}</span> vacante{{#unless (eq paginacion.totalVacantes 1)}}s{{/unless}} encontrada{{#unless (eq paginacion.totalVacantes 1)}}s{{/unless}}
            {{#if (eq paginacion.totalPaginas 1)}}{{else}}
                — Página <span class="text-white font-bold">{{paginacion.paginaActual}}</span> de <span class="text-white font-bold">{{paginacion.totalPaginas}}</span>
            {{/if}}
        </p>
    {{/if}}

    {{!-- Contenedor de las Tarjetas --}}
    {{#if vacantes.length}}
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            {{#each vacantes}}
                {{!-- Tarjeta Estilo LinkedIn/Computrabajo --}}
                <div class="bg-white/5 border border-gray-800 p-6 rounded-2xl hover:border-[#00C897] hover:shadow-[0_0_15px_rgba(0,200,151,0.1)] transition-all flex flex-col justify-between group">
                    
                    <div>
                        {{!-- Título y Empresa --}}
                        <div class="flex justify-between items-start mb-4">
                            <div>
                                <h3 class="text-2xl font-bold text-white group-hover:text-[#00C897] transition-colors mb-1">{{titulo}}</h3>
                                <div class="flex items-center gap-2 text-gray-400">
                                    <i class="fa-solid fa-user text-sm"></i>
                                    <span class="font-medium">{{creador.nombre}}</span>
                                </div>
                            </div>
                        </div>

                        {{!-- Detalles de la Vacante (Ubicación, Salario, Fecha) --}}
                        <div class="flex flex-wrap gap-4 text-sm text-gray-400 mb-6">
                            <div class="flex items-center gap-1.5">
                                <i class="fa-solid fa-location-dot"></i>
                                <span>{{ubicacion}}</span>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <i class="fa-solid fa-money-bill-wave"></i>
                                <span class="text-white font-bold">${{salario}}</span>
                            </div>
                        </div>

                        {{!-- Descripción corta (Truncada) --}}
                        <p class="text-gray-500 line-clamp-3 mb-6">
                            {{descripcion}}
                        </p>
                    </div>

                    {{!-- Footer de la Tarjeta --}}
                    <div class="flex items-center justify-between border-t border-gray-800 pt-4 mt-auto">
                        {{!-- Etiqueta de Contrato --}}
                        <span class="bg-gray-800 text-gray-300 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider">
                            {{tipo_contrato}}
                        </span>
                        
                        {{!-- Botón de Acción --}}
                        <a href="/vacantes/{{id}}" class="text-[#00C897] font-bold hover:text-white transition-colors flex items-center gap-1 border border-[#00C897] hover:bg-[#00C897] px-4 py-2 rounded-lg">
                            Ver Detalles <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            {{/each}}
        </div>

        {{!-- Controles de Paginación --}}
        {{#if (eq paginacion.totalPaginas 1)}}{{else}}
            <nav class="mt-10 flex justify-center">
                <div class="flex items-center gap-2">
                    {{!-- Botón Anterior --}}
                    {{#if paginacion.hayAnterior}}
                        <a href="/vacantes?{{buildQuery filtros (subtract paginacion.paginaActual 1)}}" 
                            class="px-4 py-2 bg-gray-800 border border-gray-700 text-gray-300 hover:bg-gray-700 hover:text-white rounded-lg text-sm font-bold transition-colors flex items-center gap-1">
                            <i class="fa-solid fa-chevron-left text-xs"></i> Anterior
                        </a>
                    {{else}}
                        <span class="px-4 py-2 bg-gray-900 border border-gray-800 text-gray-600 rounded-lg text-sm font-bold cursor-not-allowed">
                            <i class="fa-solid fa-chevron-left text-xs"></i> Anterior
                        </span>
                    {{/if}}

                    {{!-- Números de página --}}
                    {{#each (range 1 paginacion.totalPaginas)}}
                        {{#if (eq this ../paginacion.paginaActual)}}
                            <span class="px-4 py-2 bg-[#00C897] text-white rounded-lg text-sm font-bold">
                                {{this}}
                            </span>
                        {{else}}
                            <a href="/vacantes?{{buildQuery ../filtros this}}" 
                                class="px-4 py-2 bg-gray-800 border border-gray-700 text-gray-300 hover:bg-gray-700 hover:text-white rounded-lg text-sm font-bold transition-colors">
                                {{this}}
                            </a>
                        {{/if}}
                    {{/each}}

                    {{!-- Botón Siguiente --}}
                    {{#if paginacion.haySiguiente}}
                        <a href="/vacantes?{{buildQuery filtros (sum paginacion.paginaActual 1)}}" 
                            class="px-4 py-2 bg-gray-800 border border-gray-700 text-gray-300 hover:bg-gray-700 hover:text-white rounded-lg text-sm font-bold transition-colors flex items-center gap-1">
                            Siguiente <i class="fa-solid fa-chevron-right text-xs"></i>
                        </a>
                    {{else}}
                        <span class="px-4 py-2 bg-gray-900 border border-gray-800 text-gray-600 rounded-lg text-sm font-bold cursor-not-allowed">
                            Siguiente <i class="fa-solid fa-chevron-right text-xs"></i>
                        </span>
                    {{/if}}
                </div>
            </nav>
        {{/if}}

    {{else}}
        {{!-- Estado Vacío --}}
        <div class="text-center py-20 bg-white/5 border border-gray-800 border-dashed rounded-2xl">
            <i class="fa-solid fa-magnifying-glass text-6xl text-gray-600 mb-4 block"></i>
            <h2 class="text-2xl font-bold text-white mb-2">No se encontraron vacantes</h2>
            <p class="text-gray-400 mb-6">Intenta con otros términos de búsqueda o limpia los filtros.</p>
            <a href="/vacantes" class="inline-block bg-gray-800 hover:bg-gray-700 text-white font-bold py-3 px-6 rounded-xl transition-colors">
                <i class="fa-solid fa-arrow-rotate-left mr-2"></i> Limpiar Filtros
            </a>
        </div>
    {{/if}}
</div>