<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <base href="{{baseUrl}}/">
    {{#if css}}
        <style>{{{css}}}</style>
    {{else}}
        <link rel="stylesheet" href="{{baseUrl}}/dist/app.css">
    {{/if}}
    <style>
        @page { size: A4; margin: 18mm 14mm; }
        html, body { background: #ffffff !important; }
    </style>
</head>
<body class="bg-white text-gray-900">
    <div class="w-full">
        <div class="flex items-center gap-6 border-b border-gray-200 pb-6 mb-6">
            {{#if fotoPerfilSrc}}
                <img src="{{fotoPerfilSrc}}" alt="{{usuario.nombre}}" class="w-20 h-20 rounded-full object-cover border border-gray-200">
            {{else}}
                <div class="w-20 h-20 rounded-full bg-gray-100 border border-gray-200 flex items-center justify-center text-gray-400 font-black text-xl">
                    {{usuario.nombre.[0]}}
                </div>
            {{/if}}
            <div class="flex-1">
                <h1 class="text-3xl font-black text-gray-900 leading-tight">{{usuario.nombre}}</h1>
                {{#if cv.titular}}
                    <div class="text-lg font-bold text-emerald-700 mt-1">{{cv.titular}}</div>
                {{/if}}
                <div class="text-sm text-gray-600 mt-2 space-y-1">
                    <div>{{usuario.email}}</div>
                    {{#if cv.telefono}}<div>{{cv.telefono}}</div>{{/if}}
                    {{#if cv.github}}<div>{{cv.github}}</div>{{/if}}
                </div>
            </div>
        </div>

        {{#if cv.resumen}}
            <section class="mb-6">
                <h2 class="text-sm font-black uppercase tracking-wider text-gray-700 mb-2">Resumen</h2>
                <div class="text-sm text-gray-700 leading-relaxed whitespace-pre-line">{{cv.resumen}}</div>
            </section>
        {{/if}}

        {{#if skillsUsuario.length}}
            <section class="mb-6">
                <h2 class="text-sm font-black uppercase tracking-wider text-gray-700 mb-2">Skills</h2>
                <div class="flex flex-wrap gap-2">
                    {{#each skillsUsuario}}
                        <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-100">{{this}}</span>
                    {{/each}}
                </div>
            </section>
        {{/if}}

        {{#if cv.experiencia.length}}
            <section class="mb-6">
                <h2 class="text-sm font-black uppercase tracking-wider text-gray-700 mb-3">Experiencia</h2>
                <div class="space-y-4">
                    {{#each cv.experiencia}}
                        <div class="border border-gray-200 rounded-xl p-4">
                            <div class="flex items-start justify-between gap-4">
                                <div>
                                    <div class="text-base font-black text-gray-900">{{cargo}}</div>
                                    <div class="text-sm font-bold text-emerald-700">{{empresa}}</div>
                                </div>
                                <div class="text-xs font-bold text-gray-500 whitespace-nowrap">{{inicio}} — {{fin}}</div>
                            </div>
                            {{#if logros}}
                                <div class="text-sm text-gray-700 leading-relaxed mt-2 whitespace-pre-line">{{logros}}</div>
                            {{/if}}
                        </div>
                    {{/each}}
                </div>
            </section>
        {{/if}}

        {{#if cv.educacion.length}}
            <section class="mb-2">
                <h2 class="text-sm font-black uppercase tracking-wider text-gray-700 mb-3">Educación</h2>
                <div class="space-y-3">
                    {{#each cv.educacion}}
                        <div class="border border-gray-200 rounded-xl p-4 flex items-start justify-between gap-4">
                            <div>
                                <div class="text-sm font-black text-gray-900">{{titulo}}</div>
                                <div class="text-sm text-gray-700">{{institucion}}</div>
                            </div>
                            <div class="text-xs font-black text-gray-600">{{anio}}</div>
                        </div>
                    {{/each}}
                </div>
            </section>
        {{/if}}
    </div>
</body>
</html>
